#!/usr/bin/env bash
set -euo pipefail

mode="${1:-paths}"
shift || true

if [ "$#" -eq 0 ]; then
  exit 1
fi

copy_to_clipboard() {
  if [ -n "${WAYLAND_DISPLAY:-}" ] && command -v wl-copy >/dev/null 2>&1; then
    wl-copy
  elif command -v xclip >/dev/null 2>&1; then
    xclip -selection clipboard
  elif command -v xsel >/dev/null 2>&1; then
    xsel --clipboard --input
  else
    printf 'No clipboard tool found. Install wl-clipboard, xclip, or xsel.\n' >&2
    exit 1
  fi
}

case "$mode" in
  paths)
    printf '%s\n' "$@" | copy_to_clipboard
    ;;
  names)
    for path in "$@"; do
      basename -- "$path"
    done | copy_to_clipboard
    ;;
  parents)
    for path in "$@"; do
      dirname -- "$path"
    done | awk '!seen[$0]++' | copy_to_clipboard
    ;;
  shell)
    python3 - "$@" <<'PY' | copy_to_clipboard
import shlex
import sys

print(" ".join(shlex.quote(arg) for arg in sys.argv[1:]))
PY
    ;;
  *)
    printf 'Unknown mode: %s\n' "$mode" >&2
    exit 1
    ;;
esac
