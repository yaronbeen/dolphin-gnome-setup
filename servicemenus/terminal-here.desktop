[Desktop Entry]
Type=Service
MimeType=all/all;
X-KDE-ServiceTypes=KonqPopupMenu/Plugin
X-KDE-Protocol=file
X-KDE-Priority=TopLevel
X-KDE-MaxNumberOfUrls=1
Actions=TerminalHere;

[Desktop Action TerminalHere]
Name=Open Terminal Here
Icon=utilities-terminal
Exec=@BIN@/dolphin-file-action terminal -- %F
